{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/white-papers/layout,_N_T_/white-papers/page,_N_T_/white-papers"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
